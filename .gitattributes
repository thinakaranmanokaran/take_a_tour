# Normalise line endings so the working tree is identical on Windows, macOS
# and Linux. Without this, Git rewrites every file on checkout on Windows and
# produces a noisy diff on Linux.
* text=auto eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.vue  text eol=lf
*.astro text eol=lf

*.svg  text eol=lf
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff2 binary