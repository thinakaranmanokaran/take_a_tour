{
  "name": "take-a-tour-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root for Take a Tour — a zero-dependency JavaScript tour library.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspace @take-a-tour/core",
    "test": "npm run test --workspace @take-a-tour/core",
    "test:browser": "npm run test:browser --workspace @take-a-tour/core",
    "check:deps": "node scripts/check-runtime-deps.mjs",
    "pack:check": "npm run pack:check --workspace @take-a-tour/core",
    "test:consumer": "npm run test:consumer --workspace @take-a-tour/core",
    "typecheck:types": "npm run typecheck:types --workspace @take-a-tour/core",
    "docs:dev": "npm run dev --workspace @take-a-tour/docs",
    "docs:build": "npm run build --workspace @take-a-tour/docs",
    "test:browser:docs": "npm run docs:build && npm exec --workspace @take-a-tour/core -- playwright test --config playwright.docs.config.js",
    "verify": "npm run lint && npm run format:check && npm test && npm run build && npm run check:deps && npm run typecheck:types && npm run pack:check && npm run test:consumer && npm run docs:build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
