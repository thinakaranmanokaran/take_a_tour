---
/**
 * Responsive table wrapper.
 */
interface Props {
  head: string[];
  rows: (string | { html: string })[][];
}

const { head, rows } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        {head.map((cell) => <th>{cell}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) =>
              typeof cell === "string" ? <td set:html={cell} /> : <td>{cell.html}</td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>