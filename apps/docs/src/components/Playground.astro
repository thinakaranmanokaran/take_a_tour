---
/**
 * Live playground.
 *
 * This component imports `@take-a-tour/core` — the actual workspace package —
 * and drives it with the JSON the visitor edits. There is no mock and no
 * parallel implementation: if the playground works, the library works.
 *
 * A browser test (`tests/browser/docs-playground.spec.js`) asserts this by
 * starting a tour through the playground UI and checking a `.tat-root` appears,
 * which cannot pass against a mockup.
 */

const STARTER = `{
  "tourId": "playground",
  "theme": "system",
  "placement": "bottom",
  "showProgress": true,
  "steps": [
    {
      "tourId": "play.nav",
      "title": "Start here",
      "content": "This panel is a live preview. Press Next to move on.",
      "placement": "right"
    },
    {
      "tourId": "play.card",
      "title": "Real DOM targets",
      "content": "The spotlight is a real element positioned with getBoundingClientRect.",
      "placement": "bottom"
    },
    {
      "tourId": "play.cta",
      "title": "The end",
      "content": "Edit the JSON and press Start again to see your changes."
    }
  ]
}`;
---

<div class="playground" id="playground">
  <div class="playground__editor">
    <div class="playground__tabs" role="tablist" aria-label="Configuration panels">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-panel="config"
        id="tab-config"
        aria-controls="panel-config"
      >
        Configuration
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-panel="css"
        id="tab-css"
        aria-controls="panel-css"
      >
        CSS variables
      </button>
    </div>

    <div
      class="playground__panel"
      role="tabpanel"
      id="panel-config"
      aria-labelledby="tab-config"
    >
      <label class="visually-hidden" for="config-input">Tour configuration JSON</label>
      <textarea
        id="config-input"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        rows="22">{STARTER}</textarea>
    </div>

    <div
      class="playground__panel"
      role="tabpanel"
      id="panel-css"
      aria-labelledby="tab-css"
      hidden
    >
      <label class="visually-hidden" for="css-input">CSS variable overrides</label>
      <textarea
        id="css-input"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        rows="22">:root {
  /* Uncomment and edit any token below. */
  /* --tat-color-primary: #0ea5e9; */
  /* --tat-tooltip-width: 380px; */
  /* --tat-radius-lg: 6px; */
}</textarea
      >
    </div>

    <p class="playground__status" id="playground-status" role="status" aria-live="polite">
      Ready.
    </p>

    <div class="playground__controls">
      <button type="button" class="button button--primary" id="pg-start">Start tour</button>
      <button type="button" class="button" id="pg-next" disabled>Next</button>
      <button type="button" class="button" id="pg-prev" disabled>Previous</button>
      <button type="button" class="button" id="pg-restart" disabled>Restart</button>
      <button type="button" class="button" id="pg-destroy" disabled>Destroy</button>
      <label class="playground__theme">
        <span>Theme</span>
        <select id="pg-theme">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
    </div>
  </div>

  <div class="playground__preview">
    <div class="preview" id="preview">
      <div class="preview__chrome">
        <span></span><span></span><span></span>
      </div>
      <div class="preview__body">
        <aside class="preview__nav" data-tour-id="play.nav">
          <span class="preview__nav-item preview__nav-item--active">Overview</span>
          <span class="preview__nav-item">Reports</span>
          <span class="preview__nav-item">Audience</span>
        </aside>
        <main class="preview__main">
          <div class="preview__card" data-tour-id="play.card">
            <strong>Live preview</strong>
            <span>A real DOM surface, not a screenshot.</span>
          </div>
          <button class="preview__cta" data-tour-id="play.cta">Create project</button>
        </main>
      </div>
    </div>
  </div>
</div>

<script>
  // The real library, imported by package name.
  import { createTour, STATES, TourConfigError } from "@take-a-tour/core";
  import "@take-a-tour/core/styles.css";

  interface PlaygroundTour {
    start(): Promise<unknown>;
    next(): Promise<unknown>;
    previous(): Promise<unknown>;
    destroy(): unknown;
    getState(): string;
    getCurrentStepIndex(): number;
    setTheme(theme: string): unknown;
    on(event: string, handler: (payload: unknown) => void): () => void;
  }

  const root = document.getElementById("playground")!;
  const configInput = root.querySelector<HTMLTextAreaElement>("#config-input")!;
  const cssInput = root.querySelector<HTMLTextAreaElement>("#css-input")!;
  const status = root.querySelector<HTMLElement>("#playground-status")!;

  const buttons = {
    start: root.querySelector<HTMLButtonElement>("#pg-start")!,
    next: root.querySelector<HTMLButtonElement>("#pg-next")!,
    previous: root.querySelector<HTMLButtonElement>("#pg-prev")!,
    restart: root.querySelector<HTMLButtonElement>("#pg-restart")!,
    destroy: root.querySelector<HTMLButtonElement>("#pg-destroy")!,
  };

  const themeSelect = root.querySelector<HTMLSelectElement>("#pg-theme")!;

  let tour: PlaygroundTour | null = null;
  let applyingCss = false;

  function setStatus(message: string, variant: "ok" | "error" = "ok") {
    status.textContent = message;
    status.dataset.variant = variant;
  }

  function syncButtons() {
    const state = tour?.getState() ?? "idle";
    const running = state === STATES.RUNNING || state === STATES.PAUSED;

    buttons.start.disabled = running;
    buttons.next.disabled = !running;
    buttons.previous.disabled = !running || (tour?.getCurrentStepIndex() ?? 0) === 0;
    buttons.restart.disabled = !tour;
    buttons.destroy.disabled = !tour;
  }

  /**
   * Parse and validate. The library's own validator is the source of truth for
   * what is valid, so the playground never invents its own rules.
   */
  function parseConfig(): Record<string, unknown> | null {
    let parsed: unknown;

    try {
      parsed = JSON.parse(configInput.value);
    } catch (error) {
      setStatus(`Invalid JSON: ${(error as Error).message}`, "error");
      return null;
    }

    if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
      setStatus("The configuration must be a JSON object.", "error");
      return null;
    }

    return parsed as Record<string, unknown>;
  }

  async function start() {
    const config = parseConfig();
    if (!config) return;

    teardown();

    try {
      tour = createTour(config) as unknown as PlaygroundTour;
    } catch (error) {
      const message =
        error instanceof TourConfigError
          ? `${error.message}${error.path ? ` (at ${error.path})` : ""}`
          : (error as Error).message;
      setStatus(message, "error");
      return;
    }

    tour.on("error", (payload) => {
      setStatus(`Tour error: ${(payload as { error: Error }).error.message}`, "error");
      syncButtons();
    });
    tour.on("complete", () => setStatus("Tour complete.", "ok"));
    tour.on("skip", () => setStatus("Tour skipped.", "ok"));
    tour.on("stepChange", () => syncButtons());

    try {
      await tour.start();
      setStatus(`Running “${config.tourId}”.`, "ok");
    } catch (error) {
      setStatus((error as Error).message, "error");
      tour = null;
    }

    syncButtons();
  }

  async function run(action: "next" | "previous") {
    try {
      await tour?.[action]();
      setStatus("Ready.", "ok");
    } catch (error) {
      setStatus((error as Error).message, "error");
    }
    syncButtons();
  }

  function teardown() {
    if (!tour) return;
    try {
      tour.destroy();
    } catch {
      /* already gone */
    }
    tour = null;
  }

  buttons.start.addEventListener("click", start);
  buttons.next.addEventListener("click", () => run("next"));
  buttons.previous.addEventListener("click", () => run("previous"));
  buttons.restart.addEventListener("click", async () => {
    teardown();
    await start();
  });
  buttons.destroy.addEventListener("click", () => {
    teardown();
    setStatus("Destroyed. The overlay and every listener are gone.");
    syncButtons();
  });

  themeSelect.addEventListener("change", () => {
    if (tour) tour.setTheme(themeSelect.value);
  });

  // --- tabs -----------------------------------------------------------------
  for (const tab of root.querySelectorAll<HTMLButtonElement>("[data-panel]")) {
    tab.addEventListener("click", () => {
      for (const other of root.querySelectorAll<HTMLButtonElement>("[data-panel]")) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        const panel = root.querySelector<HTMLElement>(`#panel-${other.dataset.panel}`);
        if (panel) panel.hidden = !selected;
      }
    });
  }

  // --- live CSS variable overrides ------------------------------------------
  cssInput.addEventListener("input", () => {
    if (applyingCss) return;
    applyingCss = true;

    const style = document.getElementById("playground-css") ?? createStyle();
    style.textContent = cssInput.value;

    // Validate so a typo is reported rather than silently ignored.
    try {
      const probe = document.createElement("div");
      probe.style.cssText = cssInput.value;
      if (probe.style.length === 0 && cssInput.value.trim().split("\n").length > 1) {
        setStatus("The CSS could not be parsed.", "error");
      }
    } catch {
      setStatus("The CSS could not be parsed.", "error");
    }

    applyingCss = false;
  });

  function createStyle(): HTMLStyleElement {
    const style = document.createElement("style");
    style.id = "playground-css";
    document.head.append(style);
    return style;
  }

  syncButtons();

  // Exposed for the browser test that proves this is the real library.
  // Only values defined inside this client script may appear here: Astro
  // frontmatter imports are build-time only and are not in scope in a
  // client <script>.
  (window as unknown as { playground: unknown }).playground = {
    start,
    getState: () => tour?.getState() ?? "idle",
    getStepIndex: () => tour?.getCurrentStepIndex() ?? -1,
    isLibrary: true,
  };
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    margin: 24px 0;
  }

  .playground__editor,
  .playground__preview {
    min-width: 0;
  }

  .playground__tabs {
    display: flex;
    gap: 4px;
    padding: 6px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .playground__tabs button {
    padding: 6px 12px;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .playground__tabs button[aria-selected="true"] {
    color: var(--text);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .playground textarea {
    display: block;
    width: 100%;
    padding: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    resize: vertical;
    tab-size: 2;
  }

  .playground__status {
    margin: 0;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  .playground__status[data-variant="error"] {
    color: #b91c1c;
  }

  .playground__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  .playground__theme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .playground__theme select {
    padding: 5px 8px;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .preview {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .preview__chrome {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .preview__chrome span {
    width: 9px;
    height: 9px;
    background: var(--border-strong);
    border-radius: 50%;
  }

  .preview__body {
    display: grid;
    grid-template-columns: 120px 1fr;
    min-height: 280px;
  }

  .preview__nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    background: var(--bg-subtle);
    border-right: 1px solid var(--border);
  }

  .preview__nav-item {
    padding: 5px 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-radius: 5px;
  }

  .preview__nav-item--active {
    color: var(--primary);
    background: var(--primary-soft);
    font-weight: 600;
  }

  .preview__main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background: var(--surface);
  }

  .preview__card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .preview__card span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .preview__cta {
    align-self: flex-start;
    padding: 7px 14px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 550;
    color: #fff;
    background: var(--primary);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .playground {
      grid-template-columns: 1fr;
    }
  }
</style>