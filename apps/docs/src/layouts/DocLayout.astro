---
/**
 * Documentation layout: sidebar, breadcrumb trail, article, table of
 * contents and previous/next pager. All navigation is derived from
 * `nav.js`, so sidebar, pager and breadcrumbs can never disagree.
 */
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.jsx";
import Breadcrumbs from "../components/Breadcrumbs.jsx";
import Pager from "../components/Pager.jsx";
import TOC from "../components/TOC.jsx";
import { DOCS, neighbours } from "../data/nav.js";
import { url } from "../config/site.js";
import { breadcrumbJsonLd } from "../lib/seo.js";

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
const current = DOCS.find((doc) => url(doc.href) === pathname);
const { previous, next } = neighbours(current ? current.href : "");

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Docs", href: "/docs/" },
  ...(current && current.href !== "/docs/" ? [{ label: current.title }] : []),
];
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbJsonLd(breadcrumbs)]}>
  <div class="layout">
    <Sidebar current={pathname} client:idle />
    <main class="content" id="content">
      <Breadcrumbs items={breadcrumbs} />
      <TOC client:idle variant="inline" />
      <slot />
      <Pager previous={previous} next={next} />
    </main>
    <div class="layout__toc">
      <TOC client:idle />
    </div>
  </div>
</BaseLayout>
