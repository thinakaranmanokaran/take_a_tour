---
/**
 * Public page layout: BaseLayout plus the site navigation rail and the page
 * content. The rail is flush with the page edge so marketing bands keep their
 * full width; `SiteSidebar` nests the current page's sections under its entry.
 * Documentation pages use `DocLayout` instead.
 */
import BaseLayout from "./BaseLayout.astro";
import SiteSidebar from "../components/SiteSidebar.jsx";

const { title, description, jsonLd = [] } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="layout layout--site">
    <SiteSidebar current={Astro.url.pathname} client:idle />
    <main class="site-content" id="content">
      <slot />
    </main>
  </div>
</BaseLayout>
