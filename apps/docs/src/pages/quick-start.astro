---
import DocLayout from "../layouts/DocLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Table from "../components/Table.astro";
---

<DocLayout title="Quick start" description="The smallest useful tour, from empty page to running.">
  <h1>Quick start</h1>
  <p class="lede">A two-step tour, start to finish, with nothing else in the way.</p>

  <h2>1 · The page</h2>

  <CodeBlock
    lang="html"
    code={`<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/node_modules/@take-a-tour/core/styles/index.css" />
  </head>
  <body>
    <header>
      <h1>Dashboard</h1>
      <button data-tour-id="app.create">New report</button>
      <nav data-tour-id="app.nav">...</nav>
    </header>

    <button id="start">Take the tour</button>

    <script type="module" src="./main.js"></script>
  </body>
</html>`}
  />

  <h2>2 · The tour</h2>

  <CodeBlock
    lang="js"
    code={`import { createTour } from "@take-a-tour/core";

const tour = createTour({
  tourId: "dashboard-intro",
  steps: [
    {
      tourId: "app.nav",
      title: "Navigation",
      content: "Everything in the product is one click from here.",
      placement: "right",
    },
    {
      tourId: "app.create",
      title: "Create a report",
      content: "Start from a template or build one from scratch.",
      placement: "bottom",
    },
  ],
});

document.querySelector("#start").addEventListener("click", () => tour.start());`}
  />

  <h2>3 · What just happened</h2>

  <p>
    Calling <code>createTour()</code> validates the configuration, normalises it into an immutable
    snapshot, registers the tour under its id, and returns a handle. Nothing touches the DOM yet —
    that happens on <code>start()</code>.
  </p>

  <CodeBlock
    lang="js"
    code={`tour.getState();             // "idle"
tour.getCurrentStep();       // null
await tour.start();
tour.getState();             // "running"
tour.getCurrentStepIndex();  // 0

await tour.next();
tour.getCurrentStepIndex();  // 1

await tour.next();           // past the last step -> completes
tour.getState();             // "completed"
tour.destroy();              // releases everything`}
  />

  <h2>Configuration reference at a glance</h2>

  <Table
    head={["Option", "Default", "Purpose"]}
    rows={[
      ["<code>tourId</code>", "<em>required</em>", "Unique identity of this tour"],
      ["<code>steps</code>", "<em>required</em>", "Ordered list of steps"],
      ["<code>theme</code>", "<code>\"system\"</code>", "<code>light</code> · <code>dark</code> · <code>system</code>"],
      ["<code>placement</code>", "<code>\"bottom\"</code>", "Default side for anchored tooltips"],
      ["<code>showProgress</code>", "<code>true</code>", "Progress bar in the footer"],
      ["<code>spotlight</code>", "<code>true</code>", "Dim the page and cut out the target"],
      ["<code>keyboardNavigation</code>", "<code>true</code>", "Arrow keys, Escape, Home/End"],
      ["<code>closeOnEscape</code>", "<code>true</code>", "Escape ends the tour"],
      ["<code>scrollIntoView</code>", "<code>true</code>", "Scroll the target into view"],
      ["<code>target.missing</code>", "<code>\"wait\"</code>", "<code>error</code> · <code>skip</code> · <code>wait</code> · <code>fallback</code>"],
      ["<code>concurrency</code>", "<code>\"pause-previous\"</code>", "<code>pause-previous</code> · <code>stop-previous</code> · <code>reject</code>"],
      ["<code>persistence.enabled</code>", "<code>false</code>", "Store progress between visits"],
    ]}
  />

