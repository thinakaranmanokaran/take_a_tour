---
import DocLayout from "../layouts/DocLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Table from "../components/Table.astro";
import Callout from "../components/Callout.astro";
---

<DocLayout title="Framework integration" description="React, Vue, Angular and vanilla lifecycle rules.">
  <h1>Framework integration</h1>
  <p class="lede">
    There is no framework-specific build of this library. The same <code>createTour</code> works
    everywhere; only the cleanup discipline differs.
  </p>

  <Callout title="The one rule">
    <p>
      Create the tour inside the framework's setup phase, and destroy it in the corresponding
      teardown hook. A tour that outlives its component keeps an overlay, a document listener and
      a registry entry alive forever.
    </p>
  </Callout>

  <h2>React</h2>

  <CodeBlock
    lang="jsx"
    code={`import { useCallback, useEffect, useRef } from "react";
import { createTour } from "@take-a-tour/core";

export function Onboarding() {
  const tourRef = useRef(null);

  useEffect(() => {
    // Created inside the effect, never in a module or a useMemo.
    const tour = createTour({
      tourId: "react-onboarding",
      steps: [
        { tourId: "app.invite", title: "Invite your team" },
        { tourId: "app.settings", title: "Settings" },
      ],
      target: { missing: "wait", timeout: 5000 },
    });
    tourRef.current = tour;

    return () => {
      tour.destroy();
      tourRef.current = null;
    };
  }, []);

  const start = useCallback(() => tourRef.current?.start(), []);

  return <button onClick={start}>Take the tour</button>;
}`}
  />

  <h3>StrictMode</h3>

  <p>
    In development, StrictMode mounts, unmounts and remounts every component. Creating the tour
    inside the effect — with cleanup in the returned function — makes that harmless: the first tour
    is destroyed, freeing its <code>tourId</code> before the second is created.
  </p>

  <Callout title="Do not create the tour during render" variant="warn">
    <p>
      A tour created in the component body runs on every render, registering a new instance each
      time and leaking the previous one.
    </p>
  </Callout>

  <h3>Late-mounted targets</h3>

  <CodeBlock
    lang="jsx"
    code={`function Panel() {
  const [open, setOpen] = useState(false);
  return open ? <section data-tour-id="app.panel">…</section> : null;
}

// The tour waits rather than failing:
target: { missing: "wait", timeout: 5000 }`}
  />

  <h2>Vue</h2>

  <CodeBlock
    lang="vue"
    code={`<script setup>
import { onMounted, onUnmounted, ref } from "vue";
import { createTour } from "@take-a-tour/core";

let tour = null;

onMounted(() => {
  tour = createTour({
    tourId: "vue-dashboard",
    steps: [
      { tourId: "banner.main", title: "A banner" },
      { tourId: "chart.revenue", title: "Live chart" },
    ],
    target: { missing: "wait" },
  });
});

onUnmounted(() => {
  tour?.destroy();
  tour = null;
});
</script>`}
  />

  <h3>Keep-alive</h3>

  <p>
    <code>onUnmounted</code> does not fire when a component is deactivated by
    <code>&lt;KeepAlive&gt;</code>. Use <code>onDeactivated</code> to stop, and
    <code>onActivated</code> to resume.
  </p>

  <CodeBlock
    lang="vue"
    code={`import { onActivated, onDeactivated } from "vue";

onDeactivated(() => tour?.isActive() && tour.pause("deactivated"));
onActivated(() => tour?.isPaused() && tour.resume());`}
  />

  <h2>Angular</h2>

  <CodeBlock
    lang="ts"
    code={`import { AfterViewInit, OnDestroy, Component } from "@angular/core";
import { createTour, type Tour } from "@take-a-tour/core";

@Component({ /* … */ })
export class OnboardingComponent implements AfterViewInit, OnDestroy {
  private tour?: Tour;

  ngAfterViewInit(): void {
    // AfterViewInit: the targets are in the DOM by now.
    this.tour = createTour({
      tourId: "angular-onboarding",
      steps: [{ tourId: "app.cta", title: "Create", content: "Start here." }],
    });
  }

  ngOnDestroy(): void {
    this.tour?.destroy();
  }

  startTour(): void {
    this.tour?.start();
  }
}`}
  />

  <h3>Outside Angular's zone</h3>

  <p>
    The library does not schedule work through Angular's zone, so nothing needs
    <code>NgZone.runOutsideAngular</code>. Positioning uses
    <code>requestAnimationFrame</code> directly.
  </p>

  <h2>Plain JavaScript</h2>

  <CodeBlock
    lang="js"
    code={`const tour = createTour({ tourId: "x", steps: [/* … */] });

document.querySelector("#start").addEventListener("click", () => tour.start());

// Tear down when the page is replaced — for example in a Turbo or htmx
// navigation, or on sign-out.
window.addEventListener("pagehide", () => tour.destroy(), { once: true });`}
  />

  <h2>Server-side rendering</h2>

  <p>
    Importing the package is safe on the server: nothing touches <code>document</code> at module
    load. Creating a tour is not, because it builds DOM.
  </p>

  <CodeBlock
    lang="jsx"
    code={`// Next.js app router
"use client";
import { useEffect, useRef } from "react";
import { createTour } from "@take-a-tour/core";

export function Tour() {
  const ref = useRef(null);
  useEffect(() => {
    ref.current = createTour({ tourId: "ssr", steps: [/* … */] });
    return () => ref.current.destroy();
  }, []);
  return null;
}`}
  />

  <h2>SPA routing</h2>

  <p>
    A tour that spans routes works by default, because each step re-resolves its target when
    presented. Combine <code>missing: "wait"</code> with a generous timeout, and stop the tour on
    routes you do not want to annotate. <a href="/dynamic-dom">Full guide</a>.
  </p>

  <h2>Styling in a framework</h2>

  <CodeBlock
    lang="jsx"
    code={`// Import the stylesheet once, at the app entry point.
import "@take-a-tour/core/styles.css";

// Prefer it over Shadow DOM, or import the stylesheet into your shadow root
// as well — the tour appends to document.body, not to your shadow tree.
`}
  />

  <h2>Common mistakes</h2>

  <Table
    head={["Mistake", "Consequence", "Fix"]}
    rows={[
      [
        "Creating a tour during React render",
        "A new instance per render; leaks",
        "Create inside <code>useEffect</code>",
      ],
      ["Missing cleanup", "Overlay and listeners outlive the view", "Destroy in the teardown hook"],
      [
        "Reusing a <code>tourId</code> while an old tour is alive",
        "<code>TourConfigError</code>",
        "Destroy first, or use <code>{ replace: true }</code>",
      ],
      ["Shadow DOM without the stylesheet", "Unstyled overlay", "Import the CSS into the shadow root"],
      ["Expecting <code>next()</code> to be synchronous", "Reads stale step", "Await it"],
    ]}
  />
</DocLayout>