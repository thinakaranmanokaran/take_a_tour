---
/**
 * Home page — thin shell composing the static `Home` sections with the two
 * hydrated demo islands (hero above the fold, showcase below it).
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Home from "../components/pages/Home.jsx";
import HeroDemo from "../components/home/HeroDemo.jsx";
import FeatureShowcase from "../components/home/FeatureShowcase.jsx";
import { SITE } from "../config/site.js";
import { websiteJsonLd, softwareApplicationJsonLd } from "../lib/seo.js";

const title = "Take a Tour — zero-dependency JavaScript product tours";
const description = SITE.description;
---

<SiteLayout title={title} description={description} jsonLd={[websiteJsonLd(), softwareApplicationJsonLd()]}>
  <Home>
    <Fragment slot="hero-demo"><HeroDemo client:load /></Fragment>
    <Fragment slot="showcase"><FeatureShowcase client:visible /></Fragment>
  </Home>
</SiteLayout>
