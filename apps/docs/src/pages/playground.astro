---
/**
 * `/playground` — thin shell. The page body is the `PlaygroundPage`
 * component; the editor itself is the `Playground` island.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import PlaygroundPage from "../components/pages/PlaygroundPage.jsx";
import Playground from "../components/Playground.jsx";
import { breadcrumbJsonLd } from "../lib/seo.js";

const description =
  "Edit a tour's JSON configuration and watch the real @take-a-tour/core library render it — targeting, spotlight geometry and theming included.";
---

<SiteLayout
  title="Playground"
  description={description}
  jsonLd={[breadcrumbJsonLd([{ label: "Home", href: "/" }, { label: "Playground" }])]}
>
  <PlaygroundPage>
    <Playground client:load />
  </PlaygroundPage>
</SiteLayout>
