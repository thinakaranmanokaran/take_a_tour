---
/**
 * `/changelog` — thin shell around the `Changelog` page component.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Changelog from "../components/pages/Changelog.jsx";
import { breadcrumbJsonLd } from "../lib/seo.js";

const description =
  "Release notes for Take a Tour: what shipped in 0.1.0, the security posture, and the known limitations.";
---

<SiteLayout
  title="Changelog"
  description={description}
  jsonLd={[breadcrumbJsonLd([{ label: "Home", href: "/" }, { label: "Changelog" }])]}
>
  <Changelog />
</SiteLayout>
